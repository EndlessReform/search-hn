              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "title": "Embedding throughput",
      "type": "timeseries",
      "description": "Completed input texts per second, including all callers of this engine.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vllm:request_success_total{job=\"homelab-embeddings-vllm\",finished_reason=\"stop\"}[$__rate_interval]))",
          "legendFormat": "Completed inputs",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:inputs/s",
          "min": 0,
          "noValue": "No data",
