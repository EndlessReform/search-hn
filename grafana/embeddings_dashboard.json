      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Queue wait and inference time · p95",
      "type": "timeseries",
      "description": "Shows whether engine time is spent waiting or executing. These are separate distributions: their p95 values should not be added together.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:request_queue_time_seconds_bucket{job=\"homelab-embeddings-vllm\"}[$__rate_interval])))",
          "legendFormat": "Queue wait p95",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:request_inference_time_seconds_bucket{job=\"homelab-embeddings-vllm\"}[$__rate_interval])))",
          "legendFormat": "Inference p95",
          "editorMode": "code",
          "range": true,
          "instant": false
