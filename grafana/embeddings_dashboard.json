    {
      "id": 13,
      "type": "logs",
      "title": "Embedding proxy logs",
      "description": "Request completion and backend errors. ANSI colors are stripped for readability; ingestion-level severity may still be unknown. Current proxy does not log every rejected request.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"homelab-inference\",service_name=\"embedding-proxy\"} | decolorize",
          "queryType": "range",
          "editorMode": "code",
          "maxLines": 300
        }
      ],
