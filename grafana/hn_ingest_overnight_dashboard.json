    {
      "type": "timeseries",
      "title": "Share of Total Writes (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "magi07-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(increase(ingest_item_writes_total_total{item_kind=\"story\",operation=\"insert\"}[1h])) / clamp_min(sum(increase(ingest_item_writes_total_total[1h])), 1)",
          "legendFormat": "story insert"
        },
        {
          "refId": "B",
          "expr": "100 * sum(increase(ingest_item_writes_total_total{item_kind=\"story\",operation=\"update\"}[1h])) / clamp_min(sum(increase(ingest_item_writes_total_total[1h])), 1)",
          "legendFormat": "story update"
        },
        {
          "refId": "C",
          "expr": "100 * sum(increase(ingest_item_writes_total_total{operation=\"insert\"}[1h])) / clamp_min(sum(increase(ingest_item_writes_total_total[1h])), 1)",
          "legendFormat": "all inserts"
        },
        {
          "refId": "D",
          "expr": "100 * sum(increase(ingest_item_writes_total_total{operation=\"update\"}[1h])) / clamp_min(sum(increase(ingest_item_writes_total_total[1h])), 1)",
          "legendFormat": "all updates"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
